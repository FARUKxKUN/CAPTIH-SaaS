# Captih — Environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ────────────────────────────────────────────────────────────────────────────
# Clerk — Authentication (replaces Supabase Auth)
# ────────────────────────────────────────────────────────────────────────────
# From: Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET
# Webhook signing secret — from Clerk Dashboard → Webhooks
CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
# Where Clerk JWT template "supabase" puts claims — should match your Supabase project URL
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ────────────────────────────────────────────────────────────────────────────
# Supabase — Domain database (auth happens in Clerk; we use Supabase for data only)
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Bypasses RLS for webhook handlers + admin operations.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET

# ────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — Audio file storage (zero egress fees, 10 GB free)
# ────────────────────────────────────────────────────────────────────────────
# From: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
R2_BUCKET=captih-uploads
# Public domain or worker for read URLs (e.g., audio.captih.com or YOUR-ID.r2.cloudflarestorage.com)
R2_PUBLIC_URL=https://YOUR-PUBLIC-DOMAIN

# ────────────────────────────────────────────────────────────────────────────
# Upstash Redis — Distributed rate limiting (10k commands/day free)
# ────────────────────────────────────────────────────────────────────────────
# From: Upstash Console → Create Redis DB (region: eu-west-1 closest to Tunis)
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# ────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile — Invisible CAPTCHA on signup
# ────────────────────────────────────────────────────────────────────────────
# From: Cloudflare Dashboard → Turnstile → Add Site (domain: captih.com + localhost)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY

# ────────────────────────────────────────────────────────────────────────────
# PostHog — Product analytics + session replay (1M events/mo free)
# ────────────────────────────────────────────────────────────────────────────
# From: PostHog → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ────────────────────────────────────────────────────────────────────────────
# Modal — FARUKxAUTO transcription endpoint
# ────────────────────────────────────────────────────────────────────────────
MODAL_TRANSCRIBE_URL=https://YOUR-MODAL-APP.modal.run/transcribe
MODAL_TRANSCRIBE_TOKEN=YOUR_MODAL_BEARER_TOKEN

# ────────────────────────────────────────────────────────────────────────────
# Dhmad.tn — Payment provider
# ────────────────────────────────────────────────────────────────────────────
DHMAD_MERCHANT_ID=YOUR_MERCHANT_ID
DHMAD_API_KEY=YOUR_API_KEY
DHMAD_WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET

# ────────────────────────────────────────────────────────────────────────────
# Resend — Transactional email (3k/mo free)
# ────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=noreply@captih.com

# ────────────────────────────────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://captih.com
NEXT_PUBLIC_DEBUG=false
