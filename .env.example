# captih - environment variables
# Copy to .env.local and fill in your own values. .env.local is gitignored.

# --- Clerk (authentication) ------------------------------------------------
# Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET
# Clerk Dashboard -> Webhooks (subscribe to user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Supabase (Postgres database only; auth is Clerk) ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-only. Used by API routes and webhooks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET

# --- Speech-to-text inference endpoint (Modal) -----------------------------
# Accepts multipart `file`, authenticated with the X-API-Key header,
# returns { segments: [{ start, end, text }] } with word-level timestamps.
MODAL_TRANSCRIBE_URL=https://YOUR-MODAL-APP.modal.run/transcribe
MODAL_TRANSCRIBE_TOKEN=YOUR_ENDPOINT_KEY

# --- Gemini (transcript proofreading, optional) ----------------------------
# If unset, the raw model output is used unchanged.
GEMINI_API_KEY=YOUR_GEMINI_KEY

# --- Dhmad.tn (payments) ---------------------------------------------------
# sk_sandbox_ keys use the sandbox API automatically.
DHMAD_API_KEY=sk_sandbox_YOUR_KEY
DHMAD_WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET

# --- PostHog (analytics, optional) -----------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
